# ─────────────────────────────────────────────────────────────────────────────
# Fatal — the app refuses to start without these
# ─────────────────────────────────────────────────────────────────────────────
#
# Every start runs a preflight check. A missing value here stops the process
# with a sentence naming it; a missing value further down only switches off the
# feature that needs it, and says which. Run `pnpm diagnose` to check that the
# infrastructure these point at actually answers.

# Signs auth tokens. Generate one and keep it stable:
#   openssl rand -base64 32
# Changing it invalidates every existing session.
PAYLOAD_SECRET=

# Postgres connection string. From Supabase: Project Settings → Database →
# Connection string.
# The variable name is spelled with the double S for historical reasons.
#
# Which of Supabase's three strings to use:
#   Direct (db.PROJECT.supabase.co:5432)     — a server you control. IPv6-only
#                                              on newer projects, so it does NOT
#                                              work from Vercel.
#   Session pooler (...pooler.com:5432)      — same, over IPv4. Use for running
#                                              migrations from your machine.
#   Transaction pooler (...pooler.com:6543)  — serverless (Vercel). Required:
#                                              short-lived functions each open
#                                              their own connections.
POSTGRESS_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase project URL — Project Settings → API → Project URL.
SUPABASE_URL=https://PROJECT.supabase.co

# Service-role key — Project Settings → API → service_role.
# SERVER-SIDE ONLY. It bypasses row-level security. Never prefix it
# NEXT_PUBLIC_, never commit it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for uploads. Create it under Storage and mark it PUBLIC — files
# are served directly from Supabase, so a private bucket renders every image
# broken rather than protected.
SUPABASE_STORAGE_BUCKET=media

# Public base URL of this install, used in emails and absolute links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3050


# ─────────────────────────────────────────────────────────────────────────────
# Hosts
# ─────────────────────────────────────────────────────────────────────────────

# Extra hostnames allowed to serve images through next/image. The Supabase host
# is added automatically; set this only if media also comes from a CDN in front
# of storage, or from a host you migrated away from.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.example.org


# ─────────────────────────────────────────────────────────────────────────────
# Email — the app starts without it, but cannot invite anyone
# ─────────────────────────────────────────────────────────────────────────────
#
# Leaving SMTP_HOST unset is allowed and warned about on every start: the site
# runs, and invitations, password resets and notifications do not. That is fine
# for looking around, and not fine for an install with members in it.
#
# Any provider speaking SMTP works. Mailjet is the one this project is developed
# against and the one `pnpm diagnose` has been exercised with; its free tier is
# large enough for a chapter. To use it, take API Key and Secret Key from
# mailjet.com → Account settings → REST API → API Key Management:
#
#   SMTP_HOST=in-v3.mailjet.com
#   SMTP_PORT=587
#   SMTP_USER=<API Key>
#   SMTP_PASS=<Secret Key>
#
# Mailjet will not deliver as an address it has not verified, so add and confirm
# the EMAIL_FROM address below under Account settings → Sender addresses first.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Envelope sender. Must be an address your SMTP provider is authorised to send
# as, or messages will be silently dropped.
EMAIL_FROM=noreply@example.org
EMAIL_FROM_NAME=Your Organisation


# ─────────────────────────────────────────────────────────────────────────────
# Branding — optional, all have sensible defaults
# ─────────────────────────────────────────────────────────────────────────────

# Name of the software itself, shown in the admin panel.
# NEXT_PUBLIC_PRODUCT_NAME=ChapterOS

# Fallback organisation name, shown before it is set under Settings.
# NEXT_PUBLIC_DEFAULT_ORG_NAME=Your Organisation

# Noun used for the organisation in generic copy: chapter, club, branch, lodge…
# NEXT_PUBLIC_ORG_UNIT_NOUN=chapter


# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations
# ─────────────────────────────────────────────────────────────────────────────

# Link members out to an external member directory. `{query}` is replaced with
# the URL-encoded member name. Unset = the link is hidden entirely.
# DIRECTORY_SEARCH_URL=https://directory.example.org/search?q=%22{query}%22

# Perplexity, used only by the Top40 business-tag generator.
# PERPLEXITY_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Tuning — defaults are fine for most installs
# ─────────────────────────────────────────────────────────────────────────────

# Postgres pool. Defaults to 50 on a normal server and 1 on serverless, where
# every function instance holds its own pool.
#
# Supabase's SESSION pooler (port 5432) caps concurrent clients at 15, so the
# default of 50 fails there with "max clients reached in session mode". Set this
# below 15 when you connect through it — including for `pnpm migrate` and
# `pnpm bootstrap` from your own machine.
# PG_POOL_MAX=5
# PG_POOL_MIN=0

# Per-query ceiling in ms, sent as a connection startup parameter. Set to 0 if
# your connection pooler answers with "unsupported startup parameter".
# PG_STATEMENT_TIMEOUT=30000

# Log queries slower than this many ms. On by default in development (100ms).
# SLOW_QUERY_LOG=1
# SLOW_QUERY_MS=1000

# Set to 1 to turn off background thumbnail generation entirely. Serverless
# hosts no longer need this: thumbnails are held open with `after()` there
# rather than detached, so they complete.
# DISABLE_THUMBNAIL_GENERATION=0

# Set to `off` to stop deleting uploads when they stop being used. By default,
# removing an image from a slide, a gallery or a profile deletes the file too,
# unless another document still points at it. Turning this off means the media
# library accumulates orphans again; `pnpm clean:media` sweeps them up.
# MEDIA_CLEANUP=off

# Maximum upload sizes in MB. Default 15/50 on a normal server; both default to
# 4 on serverless, staying under Vercel's 4.5MB request-body cap so uploads fail
# with our message instead of the platform's bare 413. Raising these does not
# raise the platform cap.
# MAX_IMAGE_UPLOAD_MB=15
# MAX_AUDIO_UPLOAD_MB=50

# Write logs to ./logs/app.log. On by default on a normal server, off on
# serverless (read-only filesystem — console output is what the platform
# collects). 1 forces on, 0 forces off.
# LOG_TO_FILE=1

# Force serverless behaviour (small DB pool, no file logging, no memory
# watchdog) on a host we don't detect automatically. Vercel, Netlify and Lambda
# are detected on their own.
# SERVERLESS=1


# ─────────────────────────────────────────────────────────────────────────────
# First-run setup — only needed to run `pnpm bootstrap` non-interactively
# ─────────────────────────────────────────────────────────────────────────────

# SETUP_ORG_NAME=Riga Business Club
# SETUP_ADMIN_EMAIL=admin@example.org
# SETUP_ADMIN_PASSWORD=
# SETUP_ADMIN_FIRST_NAME=Admin
# SETUP_ADMIN_LAST_NAME=User
