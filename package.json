{
  "name": "chapteros",
  "version": "0.1.0",
  "description": "Self-hostable member portal for professional networking organisations — directory, referrals, one-to-ones, events and business tracking.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/igstudija/chapter-web"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "pnpm run preflight && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050",
    "dev:turbo": "pnpm run preflight && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050 --turbopack",
    "devsafe": "rm -rf .next && pnpm run preflight && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preflight": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/preflight.ts",
    "start": "pnpm run preflight && cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int",
    "test:db": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.db.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "generate:top40-tags": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/generateTop40Tags.ts",
    "postinstall": "node -e \"const fs=require('fs');const src='node_modules/tinymce';const dst='public/tinymce';if(fs.existsSync(dst)){fs.rmSync(dst,{recursive:true,force:true})}if(fs.existsSync(src)){fs.cpSync(src,dst,{recursive:true,dereference:true});console.log('TinyMCE copied to public/')}\"",
    "bootstrap": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/setup.ts",
    "seed:policies": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seedPolicyTemplates.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "typecheck": "tsc --noEmit",
    "diagnose": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/diagnose.ts",
    "clean:media": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/cleanMedia.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.69.0",
    "@payloadcms/next": "3.69.0",
    "@payloadcms/plugin-cloud-storage": "3.69.0",
    "@payloadcms/richtext-lexical": "3.69.0",
    "@payloadcms/ui": "3.69.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tinymce/tinymce-react": "^4.3.2",
    "autoprefixer": "^10.4.23",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "libphonenumber-js": "^1.12.35",
    "lucide-react": "^0.562.0",
    "next": "15.4.10",
    "next-intl": "^4.7.0",
    "nodemailer": "^6.9.16",
    "openai": "^6.18.0",
    "payload": "3.69.0",
    "pg": "^8.17.2",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.14",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.2",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "tinymce": "5.10.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.7",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
